# Non-secret deployment coordinates. Keep actual values in an untracked .env.
HOMEZ_IMAGE=ghcr.io/deepkuba/homez
HOMEZ_IMAGE_TAG=sha-reviewed-commit
HOMEZ_SECRETS_DIR=/etc/homez/secrets
HOMEZ_CONFIG_DIR=/etc/homez/config
HOMEZ_STATE_DIR=/var/lib/homez
HOMEZ_DOMAIN=feedback.example.com
HOMEZ_ACME_EMAIL=owner@example.com
# Dedicated shared-VPS bridge; confirm it does not overlap another Docker network.
HOMEZ_FRONTEND_SUBNET=172.30.138.0/28
HOMEZ_TRUSTED_PROXY_IP=172.30.138.1

# Mailtrap sandbox; replace the inbox ID. Production uses send.api.mailtrap.io.
HOMEFINDER_MAIL_API_ENDPOINT=https://sandbox.api.mailtrap.io/api/send/REPLACE_WITH_INBOX_ID
HOMEFINDER_MAIL_API_HOST=sandbox.api.mailtrap.io
HOMEFINDER_MAIL_SENDER=homefinder@example.invalid
