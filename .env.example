# Copy to .env on the VPS and replace this value. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
HOMEFINDER_ENVIRONMENT=production
HOMEFINDER_GMAIL_TOKEN_FILE=/run/secrets/homefinder_gmail_token
HOMEFINDER_GMAIL_TOKEN_KEY_FILE=/run/secrets/homefinder_gmail_token_key
HOMEFINDER_GMAIL_SOURCE_POLICY_FILE=/run/secrets/homefinder_source_policy
HOMEFINDER_GMAIL_MAILBOX_KEY=primary
HOMEFINDER_REPORT_RECIPIENT_FILE=/run/secrets/homefinder_report_recipient
HOMEFINDER_MAIL_API_TOKEN_FILE=/run/secrets/homefinder_mail_api_token
HOMEFINDER_MAIL_API_ENDPOINT=https://approved-mail-provider.example/v1/send
HOMEFINDER_MAIL_API_HOST=approved-mail-provider.example
HOMEFINDER_MAIL_SENDER=homefinder@example.com

# Prefer an immutable sha-<commit> tag for reviewed deployments.
HOMEZ_IMAGE=ghcr.io/deepkuba/homez
HOMEZ_IMAGE_TAG=main
